#!/bin/sh
# colabfold -- entry point of the ColabFold Setonix image (ports/colabfold). It keeps the host's software environment out and runs the
# port's own scripts on the image's tree, /opt/colabfold: the same tree a native install has (venv/, kit/, kitpin/, scripts/), plus
# MMseqs2's GPU build in bin/. POSIX sh on purpose: Pawsey's singularity modules export BASH_ENV, which bash would source. Run WITHOUT --rocm.
#
#   colabfold predict --mode off|exact|fast|big [--n_gpu P] INPUT RESULTS [colabfold_batch options]
#                                  ColabFold 1.6.3 through the kit (scripts/cfs-run.sh): off = stock, exact, fast (one GCD), big (--n_gpu)
#   colabfold search QUERIES.fasta OUTDIR [colabfold_search options]
#                                  MSAs with colabfold_search on the GPU build of MMseqs2 (scripts/cf-search.sh; one GPU node)
#   colabfold mmseqs ...           the GPU MMseqs2 binary itself
#   colabfold check [--no-gpu]     versions, pins, GPUs, MMseqs2's GPU search, where every GPU library was loaded from
#   colabfold version | python ... | shell ... | help
#
# Weights: the AlphaFold2-Multimer v3 parameters are not in the image. The default is Pawsey's copy,
# /scratch/references/colabfold_jun2026/database/alphafold2_multimer_v3; set COLABFOLD_OPT_DATA_DIR for another. Databases for search:
# COLABFOLD_DB (default Pawsey's /scratch/references/colabfold_jun2026/database). Compiled programs: COLABFOLD_OPT_JIT_ROOT (default a
# per-user directory under TMPDIR, so each job compiles again; point it at /scratch to keep them). Setonix starts every job from a fresh
# login environment (SBATCH_EXPORT=NONE), so set these, and CFS_SERIALISE / XLA_PYTHON_CLIENT_MEM_FRACTION, inside the job script.
set -eu

note() { printf '[colabfold] %s\n' "$*" >&2; }

# 1. Nothing of the host's software environment reaches the model process: its Python and loader variables, Lmod's variables and the
#    exported `module` function are dropped. Slurm's variables, ROCR_VISIBLE_DEVICES, the port's CFS_* words, COLABFOLD_* settings and
#    XLA_PYTHON_CLIENT_MEM_FRACTION pass through. XLA_CLIENT_MEM_FRACTION never does: with it jax silently runs on the CPU.
for v in PYTHONPATH PYTHONHOME PYTHONSTARTUP PYTHONUSERBASE PYTHONEXECUTABLE LD_PRELOAD LD_AUDIT HIP_PATH HSA_PATH ROCM_HOME \
         HIP_PLATFORM XLA_CLIENT_MEM_FRACTION JAX_COMPILATION_CACHE_DIR BASH_ENV ENV \
         LMOD_PKG LMOD_CMD LMOD_DIR MODULEPATH MODULESHOME LOADEDMODULES _LMFILES_; do
  unset "$v" 2>/dev/null || true
done
W=/opt/colabfold
export CFS_W=$W ROCM_PATH=/opt/rocm LD_LIBRARY_PATH=/opt/rocm/lib PYTHONNOUSERSITE=1 PYTHONUNBUFFERED=1 \
       PATH=$W/scripts/bin:$W/bin:$W/venv/bin:/opt/rocm/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
CLEAN="env -u BASH_FUNC_module%% -u BASH_FUNC_ml%% -u BASH_FUNC_which%%"

# 2. Writable caches outside $HOME (1 GB quota on Setonix) and outside the read-only image.
T=${CFS_TMP:-${TMPDIR:-/tmp}/colabfold-$(id -u)}
mkdir -p "$T" 2>/dev/null || T=$(mktemp -d)
export XDG_CACHE_HOME="$T/xdg" MPLCONFIGDIR="$T/mpl" PIP_CACHE_DIR="$T/pip" TRITON_CACHE_DIR="$T/triton" \
       MIOPEN_USER_DB_PATH="$T/miopen" MIOPEN_CUSTOM_CACHE_DIR="$T/miopen" COLABFOLD_OPT_JIT_ROOT="${COLABFOLD_OPT_JIT_ROOT:-$T/jit}"

cmd=${1:-help}
[ $# -gt 0 ] && shift
case "$cmd" in
  predict)
    exec $CLEAN /bin/bash $W/scripts/cfs-run.sh pred "$@" ;;
  search)
    exec $CLEAN /bin/bash $W/scripts/cf-search.sh "$@" ;;
  mmseqs)
    exec $W/bin/mmseqs "$@" ;;
  check)
    exec $CLEAN /bin/bash -c '. "$0/scripts/cf-env.sh" > /dev/null 2>&1; export XLA_PYTHON_CLIENT_PREALLOCATE=false
                              exec python "$0/container/colabfold_check.py" "$@"' "$W" "$@" ;;
  version)
    cat $W/source.txt $W/kit.txt $W/rocm-packages.txt $W/bin/mmseqs-build.txt 2>/dev/null; exit 0 ;;
  python)
    exec $CLEAN python "$@" ;;
  shell)
    exec $CLEAN /bin/bash --noprofile --norc "$@" ;;
  help|-h|--help)
    sed -n '2,/^set -eu/p' "$0" | sed '$d; s/^# \{0,1\}//'; exit 0 ;;
  *)
    note "unknown command '$cmd' (colabfold help)"; exit 2 ;;
esac
